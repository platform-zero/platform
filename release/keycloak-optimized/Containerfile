# Offline, credential-free Quarkus augmentation of the exact original pinned image.
# Runtime database credentials, TLS and hostname are supplied only by owned Quadlet inputs.
FROM quay.io/keycloak/keycloak@sha256:3e1ac632e743660017b1e6bb4c3ffc800fd02c82cdd0db858cd03456a98a8dfc
ENV KC_DB=postgres \
    KC_HEALTH_ENABLED=true \
    KC_METRICS_ENABLED=true
WORKDIR /opt/keycloak
RUN /opt/keycloak/bin/kc.sh build
